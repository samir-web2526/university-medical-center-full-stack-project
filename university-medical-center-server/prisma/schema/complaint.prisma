model Complaint {
  id String @id @default(uuid())

  name    String
  phone   String
  email   String
  subject String
  message String @db.Text

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("complaint")
}
