model Notification {
  id String @id @default(uuid())

  title   String
  message String

  type   NotificationType
  isRead Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  visitId        String?
  prescriptionId String?
  medicineId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification")
}
